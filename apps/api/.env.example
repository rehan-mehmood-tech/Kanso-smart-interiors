# Kanso API configuration.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Service ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# Origins allowed to call this API. Comma-separated or a JSON array.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase ---------------------------------------------------------------
# Project not created yet. Once it exists:
#   Dashboard -> Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Server-side only --
# it must never reach the browser or a Next.js client component.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private storage buckets (signed-URL access only).
ROOM_PHOTOS_BUCKET=room-photos
GENERATED_DESIGNS_BUCKET=generated-designs

# --- AI providers -----------------------------------------------------------
# Two-stage pipeline: Gemini reads the four wall photos into a structured
# spatial brief, Flux renders the concepts from it.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
FLUX_MODEL=black-forest-labs/flux-1.1-pro

# --- Generation limits ---
DESIGNS_PER_GENERATION=5
GENERATION_TIMEOUT_SECONDS=180
