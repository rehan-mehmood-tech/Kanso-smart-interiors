# Kanso API (Render) configuration.
#
# Copy to .env for development. Everything here is server-side; none of it is
# ever sent to a browser. In production these are set in the Render dashboard
# as sync:false variables (see render.yaml) rather than committed.

# --- Service -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# --- CORS ----------------------------------------------------------------------
# Origins allowed to call this API. Comma-separated or a JSON array.
# In production this is the Vercel production domain; preview deployments are
# matched by an anchored regex in app/core/config.py, because Vercel generates
# a new hostname for every preview.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=

# --- Supabase ------------------------------------------------------------------
# Dashboard -> Project Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It must never appear
# in apps/web, in a NEXT_PUBLIC_ variable, or in any client bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private storage buckets, signed-URL access only.
ROOM_PHOTOS_BUCKET=room-photos
GENERATED_DESIGNS_BUCKET=generated-designs

# --- AI providers --------------------------------------------------------------
# Two-stage pipeline: Gemini reads the four wall photos into a structured
# spatial brief; an image provider renders concepts from it.

# https://aistudio.google.com/apikey
# NOTE: gemini-1.5-* and 2.5-* are retired for new keys. Check what your key
# can reach with:  GET /v1beta/models?key=...
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash

# Image generation. pollinations is free and needs no credential; huggingface
# is the fallback and uses the token below.
IMAGE_GENERATOR_PROVIDER=pollinations
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
FLUX_MODEL=black-forest-labs/flux-1.1-pro

# https://console.groq.com/keys — fast inference for text-side work.
GROQ_API_KEY=

# --- Generation limits ---------------------------------------------------------
DESIGNS_PER_GENERATION=5
GENERATION_TIMEOUT_SECONDS=180
