# Kanso monorepo — root reference.
#
# Nothing reads this file at runtime; it is the map of which variable belongs
# to which deployment target. Copy the relevant block into the app you are
# configuring, or into the Vercel / Render dashboard.
#
#   apps/web (Vercel)  -> apps/web/.env.example
#   apps/api (Render)  -> apps/api/.env.example
#
# Rule of thumb: anything prefixed NEXT_PUBLIC_ is compiled into the browser
# bundle and is therefore public. Everything else must stay server-side.

# --- Shared identity -----------------------------------------------------------
# The production site origin, used by the API for CORS and by the web app for
# absolute links. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kanso.pk

# The Render service origin. The web app proxies /api/* here.
NEXT_PUBLIC_API_URL=https://kanso-api.onrender.com

# --- Supabase ------------------------------------------------------------------
# Public (browser-safe) half — belongs in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret half — belongs in Render ONLY. The service-role key bypasses row-level
# security; if it reaches the browser, every row in the database is readable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (Render only) ------------------------------------------------
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
GROQ_API_KEY=
